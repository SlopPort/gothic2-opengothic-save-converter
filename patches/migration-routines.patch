+JSValue setMigrationRoutine(JSContext* ctx, JSValueConst obj, int argc, JSValueConst* argv) {
+  Npc* npc = self(ctx,obj);
+  if(npc==nullptr || argc<1)
+    return JS_FALSE;
+  auto name = js::str(ctx,argv[0]);
+  if(name.rfind("RTN_",0)!=0)
+    return JS_ThrowRangeError(ctx,"expected a named RTN_ routine");
+  auto* symbol = npc->world().script().getVm().find_symbol_by_name(name);
+  if(symbol==nullptr || symbol->type()!=zenkit::DaedalusDataType::FUNCTION || symbol->count()!=0 || symbol->is_external())
+    return JS_FALSE;
+  npc->clearAiQueue();
+  npc->clearGoTo();
+  npc->clearState(true);
+  npc->excRoutine(symbol->index());
+  return JS_TRUE;
+  }
